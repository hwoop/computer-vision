g pₜ(x)\n","\n","      # Prepare evenly spaced x-values to draw the vector field\n","      x_vals = torch.linspace(-5, 5, 200).unsqueeze(1).to(device)\n","      t_vals = torch.full((x_vals.shape[0],), t1, dtype=torch.float32, device=device)\n","      pred_noise_x = model(x_vals, t_vals)\n","      scores_x = -pred_noise_x / (1 - alpha_bar)\n","\n","      # Convert to NumPy\n","      x_plot = x_vals.cpu().numpy().flatten()\n","      score_plot = scores_x.cpu().numpy().flatten()\n","      score_plot = score_plot / np.linalg.norm(score_plot)\n","      xt_np = xt.cpu().numpy().flatten()\n","\n","      # Plotting\n","      plt.figure(figsize=(10, 4))\n","      plt.hist(xt_np, bins=100, density=True, alpha=0.5, label=\"Noisy Data at t\")\n","\n","      # Plot the score itself at each position - vertical height is the log likelihood\n","      plt.plot(x_plot, score_plot, color='blue', label='Score')\n","      plt.title(f\"Score Field and Noisy Data at Timestep {t1}\")\n","      plt.xlabel(\"x\")\n","      plt.ylabel(\"Density / Score\")\n","      plt.legend()\n","      plt.grid(True)\n","      plt.axhline(0, color='black', linewidth=0.5)\n","      plt.tight_layout()\n","      plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"XD3Dh869KkeS","executionInfo":{"status":"ok","timestamp":1748327487126,"user_tz":-540,"elapsed":2460,"user":{"displayName":"Christian Wallraven","userId":"03337635927690584726"}},"outputId":"8856687d-25ba-4a1f-f4cd-4590c3ceb110"},"execution_count":9,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x400 with 1 Axes>"]
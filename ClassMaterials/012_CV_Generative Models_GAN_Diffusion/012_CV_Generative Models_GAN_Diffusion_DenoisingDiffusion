{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMa1MwkR+Kryi61vxCz1vSF"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":18,"metadata":{"id":"o99nOO8bEx_t","executionInfo":{"status":"ok","timestamp":1748327777306,"user_tz":-540,"elapsed":8,"user":{"displayName":"Christian Wallraven","userId":"03337635927690584726"}}},"outputs":[],"source":["#Import standards\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import torch\n","import torch.nn as nn\n","import torch.optim as optim\n","\n","# Configs\n","T = 1000  # diffusion steps\n","\n","# betas[t] controls how much Gaussian noise is added to the data at timestep t.\n","# It's part of the forward diffusion process, where we gradually corrupt data with noise.\n","# beta_start and beta_end define the range of noise added per step.\n","# We use a linear schedule, but cosine or other schedules can also used in advanced models.\n","beta_start = 0.0001\n","beta_end = 0.8\n","betas = np.linspace(beta_start, beta_end, T)\n","\n","# alphas[t] is the retained signal fraction at timestep t (i.e., how much of the original data remains after adding noise).\n","# alphas_cumprod[t] is the cumulative product: it tells you how much of the original data signal remains after t steps.\n","alphas = 1.0 - betas\n","alphas_cumprod = np.cumprod(alphas)\n","\n","# check cuda\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\""]},{"cell_type":"code","source":["# Generate 1D toy data\n","def sample_data(n=1000):\n","    return np.random.normal(loc=2.0, scale=1.0, size=(n, 1)).astype(np.float32)"],"metadata":{"id":"_7pandD_FHpQ","executionInfo":{"status":"ok","timestamp":1748327779384,"user_tz":-540,"elapsed":3,"user":{"displayName":"Christian Wallraven","userId":"03337635927690584726"}}},"execution_count":19,"outputs":[]},{"cell_type":"code","source":["# Generate 1D toy data from mixture of 3 Gaussians\n","def sample_data_3(n=1000):\n","    components = [\n","        np.random.normal(loc=-2.0, scale=0.3, size=(n // 3, 1)),\n","        np.random.normal(loc=0.0, scale=0.5, size=(n // 3, 1)),\n","        np.random.normal(loc=2.0, scale=0.3, size=(n // 3, 1)),\n","    ]\n","    return np.vstack(components).astype(np.float32)"],"metadata":{"id":"4ic_yfxTOKx6","executionInfo":{"status":"ok","timestamp":1748327780002,"user_tz":-540,"elapsed":5,"user":{"displayName":"Christian Wallraven","userId":"03337635927690584726"}}},"execution_count":20,"outputs":[]},{"cell_type":"code","source":["data = sample_data_3(5000)\n","plt.hist(data, bins=100, density=True, alpha=0.7, label=\"Target Distribution\")\n","plt.title(\"1D Toy Data: Mixture of Gaussians\")\n","plt.xlabel(\"x\")\n","plt.ylabel(\"Density\")\n","plt.legend()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":472},"id":"XcNMsAnfOXiO","executionInfo":{"status":"ok","timestamp":1748327780967,"user_tz":-540,"elapsed":387,"user":{"displayName":"Christian Wallraven","userId":"03337635927690584726"}},"outputId":"d2d1261a-e796-4d87-907d-76c87f9cd3a2"},"execution_count":21,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Neural net for denoising - standard MLP\n","class DenoiseNet(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Linear(2, 16),\n","            nn.ReLU(),\n","            nn.Linear(16, 16),\n","            nn.ReLU(),\n","            nn.Linear(16, 1)\n","        )\n","\n","    def forward(self, x, t):\n","        t = t / T  # normalize timestep\n","        t_input = t.unsqueeze(1)\n","        x_input = torch.cat([x, t_input], dim=1)\n","        return self.net(x_input.float())"],"metadata":{"id":"3V9yiXLSFVMU","executionInfo":{"status":"ok","timestamp":1748327782842,"user_tz":-540,"elapsed":144,"user":{"displayName":"Christian Wallraven","userId":"03337635927690584726"}}},"execution_count":22,"outputs":[]},{"cell_type":"code","source":["# Forward diffusion process\n","# This is how the noisy version of x0 is generated at time t.\n","# It blends the original data with Gaussian noise, using weights derived from alphas_cumprod[t].\n","def q_sample(x_start, t, noise=None):\n","    if noise is None:\n","        noise = torch.randn_like(x_start)\n","    sqrt_alpha_cumprod = torch.sqrt(torch.tensor(alphas_cumprod[t])[:, None]).to(device)\n","    sqrt_one_minus = torch.sqrt(1 - torch.tensor(alphas_cumprod[t])[:, None]).to(device)\n","    return sqrt_alpha_cumprod * x_start + sqrt_one_minus * noise"],"metadata":{"id":"W7a099uRFXNg","executionInfo":{"status":"ok","timestamp":1748327783383,"user_tz":-540,"elapsed":5,"user":{"displayName":"Christian Wallraven","userId":"03337635927690584726"}}},"execution_count":23,"outputs":[]},{"cell_type":"code","source":["# Training loop\n","model = DenoiseNet().to(device)\n","optimizer = optim.Adam(model.parameters(), lr=1e-3)\n","loss_fn = nn.MSELoss()\n","\n","data = torch.tensor(data).to(device)\n","\n","model.train()\n","\n","loss_values = []\n","\n","for epoch in range(10000):\n","\n","    # take a random batch from our sample data\n","    idx = torch.randint(0, data.shape[0], (256,))\n","    x0 = data[idx]\n","    # get random timesteps from all possible timesteps\n","    t = torch.randint(0, T, (x0.shape[0],), device=device).long()\n","    # added noise injection\n","    noise = torch.randn_like(x0)\n","\n","    # run forward diffusion\n","    xt = q_sample(x0, t, noise)\n","    # get predictions\n","    predicted_noise = model(xt, t.float())\n","\n","    # measure loss - this is simply L2\n","    loss = loss_fn(predicted_noise, noise)\n","    optimizer.zero_grad()\n","    loss.backward()\n","    optimizer.step()\n","\n","    loss_values.append(loss.item())\n","\n","    if epoch % 500 == 0:\n","        print(f\"Epoch {epoch}, Loss: {loss.item():.4f}\")\n","\n","plt.plot(loss_values)\n","window_size = 11\n","weights = np.ones(window_size) / window_size\n","sma = np.convolve(loss_values, weights, mode='valid')\n","plt.plot(sma)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":777},"id":"WsuGMVoHHADC","executionInfo":{"status":"ok","timestamp":1748327801324,"user_tz":-540,"elapsed":17191,"user":{"displayName":"Christian Wallraven","userId":"03337635927690584726"}},"outputId":"4ce30bb6-5f2d-4bbb-8e62-80b4cd42adf6"},"execution_count":24,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 0, Loss: 1.1264\n","Epoch 500, Loss: 0.0643\n","Epoch 1000, Loss: 0.1016\n","Epoch 1500, Loss: 0.0665\n","Epoch 2000, Loss: 0.1076\n","Epoch 2500, Loss: 0.0619\n","Epoch 3000, Loss: 0.1095\n","Epoch 3500, Loss: 0.0331\n","Epoch 4000, Loss: 0.0398\n","Epoch 4500, Loss: 0.0227\n","Epoch 5000, Loss: 0.0526\n","Epoch 5500, Loss: 0.0525\n","Epoch 6000, Loss: 0.0345\n","Epoch 6500, Loss: 0.0205\n","Epoch 7000, Loss: 0.0487\n","Epoch 7500, Loss: 0.0437\n","Epoch 8000, Loss: 0.0289\n","Epoch 8500, Loss: 0.0470\n","Epoch 9000, Loss: 0.0441\n","Epoch 9500, Loss: 0.0475\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Denoising (reverse process)\n","@torch.no_grad()\n","def sample_reverse(n_samples=1000):\n","    # get random data\n","    x = torch.randn((n_samples, 1)).to(device)\n","    # go \"back\" in time\n","    for t in reversed(range(T)):\n","        t_tensor = torch.full((n_samples,), t, device=device).float()\n","        # predict the noise vector\n","        pred_noise = model(x, t_tensor)\n","        alpha = alphas[t]\n","        alpha_bar = alphas_cumprod[t]\n","        beta = betas[t]\n","        # get the current average\n","        mean = (1 / np.sqrt(alpha)) * (x - ((1 - alpha) / np.sqrt(1 - alpha_bar)) * pred_n